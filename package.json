{
  "name": "sonnet-bot",
  "version": "2.0.0",
  "description": "Moodie Pet / Sonnet Bot v2.0 —— 系统感知伴侣 + 四大主题分身大一统（🌈 彩色可爱 / ⚫ Sonnet 极简 / 🏺 3D 骨瓷天使球 / 🫧 深海驾驶舱全息球 + 本地 HTTP/WebSocket 系统感知联动）",
  "author": "sukikeeling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sukikeeling/moodie-pet.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sensor": "node moodie-cli.js status",
    "test": "node verify.js",
    "dist": "electron-builder --win portable",
    "pack": "electron-builder --dir --win portable",
    "icon": "node gen-icon.js"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "shimeji",
    "sonnet-bot",
    "moodie",
    "system-perception",
    "threejs",
    "ceramic-bot",
    "submarine-cabin-bot",
    "windows"
  ],
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sukikeeling.sonnet-bot",
    "productName": "Sonnet Bot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDownload": {
      "isVerifyChecksum": false
    },
    "files": [
      "main.js",
      "preload.js",
      "system-sensor.js",
      "moodie-cli.js",
      "pet.html",
      "data.js",
      "morph-engine.js",
      "package.json",
      "grok-recipes.js",
      "grok-player.bundle.js",
      "skins-3d.js",
      "skins-3d.bundle.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
